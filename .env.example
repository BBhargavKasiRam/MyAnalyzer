# ==============================================================================
# MyAnalyzer - Environment Configuration Template (.env.example)
# ==============================================================================

# [REQUIRED] MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/myanalyzer?retryWrites=true&w=majority

# [OPTIONAL] Express API Server Port
PORT=5000

# [OPTIONAL] Environment Mode ('development' | 'production')
NODE_ENV=development

# [OPTIONAL] Client URL for CORS policy
CLIENT_URL=http://localhost:5173

# [OPTIONAL] Scheduled Background Sync Cron Pattern
SYNC_CRON_SCHEDULE=0 */6 * * *

# [OPTIONAL] Frontend Vite API Base URL
VITE_API_URL=/api
